{
  "permissions": {
    "allow": [
      "Shell(git:fetch *)",
      "Shell(git:rev-parse *)",
      "Shell(git:branch *)",
      "Shell(git:switch *)",
      "Shell(git:checkout *)",
      "Shell(git:status*)",
      "Shell(git:log *)",
      "Shell(git:diff *)",
      "Shell(git:add *)",
      "Shell(git:commit *)",
      "Shell(git:stash *)",
      "Shell(git:merge origin/main)",
      "Shell(git:rebase origin/main)",
      "Shell(git:merge-tree *)",
      "Shell(git:pull --ff-only origin Babu)",
      "Shell(git:push origin Babu)",
      "Shell(git:push -u origin Babu)",
      "Shell(git:push origin --delete Babu)",
      "Shell(git:clone https://github.com/DeusData/codebase-memory-mcp.git*)",
      "Shell(gh:pr create --base main --head Babu *)",
      "Shell(gh:pr merge --squash *)",
      "Shell(gh:pr view *)",
      "Shell(gh:pr list *)",
      "Shell(node:-v)",
      "Shell(npm:-v)",
      "Shell(npm:ci*)",
      "Shell(npm:run dev*)",
      "Shell(npm:run lint*)",
      "Shell(npm:run build*)",
      "Shell(npm:audit*)",
      "Shell(curl:http://localhost:3000*)",
      "Shell(powershell:*Get-NetTCPConnection -LocalPort 3000*)",
      "Shell(powershell:*Get-Process -Id *)",
      "Shell(powershell:*Get-CimInstance Win32_Process -Filter *)",
      "Shell(powershell:*Stop-Process -Id * -Force*)",
      "Mcp(codebase-memory-mcp:index_repository)",
      "Mcp(codebase-memory-mcp:index_status)",
      "Mcp(codebase-memory-mcp:detect_changes)",
      "Mcp(codebase-memory-mcp:delete_project)",
      "Mcp(codebase-memory-mcp:list_projects)",
      "Mcp(codebase-memory-mcp:search_graph)",
      "Mcp(codebase-memory-mcp:trace_path)",
      "Mcp(codebase-memory-mcp:get_code_snippet)",
      "Mcp(codebase-memory-mcp:query_graph)",
      "Mcp(codebase-memory-mcp:get_architecture)",
      "Mcp(codebase-memory-mcp:search_code)"
    ],
    "deny": [
      "Shell(git:push --force*)",
      "Shell(git:push -f *)",
      "Shell(git:push upstream *)",
      "Shell(git:push origin main*)",
      "Shell(git:push origin --delete main*)",
      "Shell(git:reset --hard*)",
      "Shell(git:clean -fd*)",
      "Shell(git:config *)",
      "Shell(gh:pr create --base main --head Dani *)",
      "Shell(rm)",
      "Read(.env*)",
      "Write(**/.env*)"
    ]
  }
}
