# Copy missing entries into .env.local. Keep existing Google login values.
# See docs/ai-assistant.md for where to obtain each value.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Google AI Studio > API Keys > Create API key
GEMINI_API_KEY=

# Upstash Console > Redis > your database > Details > REST API
# Use the read/write REST token, not the read-only token or Redis password.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel: set the same variables in Project Settings > Environment Variables,
# using AUTH_URL=https://ibv-viewer.vercel.app, then redeploy.
